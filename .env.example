# Default: local-only. Public deployment MUST terminate TLS and set these values.
HOST=127.0.0.1
PORT=8787
# PUBLIC_ORIGIN=https://panel.example.com
# TRUST_PROXY=loopback
# PANEL_DATA=D:/SafehouseData
# STEAMCMD_PATH=D:/SteamCMD/steamcmd.exe
# STEAM_API_KEY=your-steam-web-api-key
# STEAM_PROXY_URL=http://127.0.0.1:7890
# Optional admin-specified, TLS-verified official Steam CDN routing:
# STEAM_DNS_OVERRIDES={}
# STEAM_TLS_NO_SNI_HOSTS=steamcommunity.com
# Optional: official SteamRE DepotDownloader for Linux SteamCMD compatibility issues.
# DEPOT_DOWNLOADER_PATH=/opt/depotdownloader/DepotDownloader
# DOTNET_PATH=/usr/bin/dotnet
# ALLOWED_ROOTS=D:/GameServers;D:/SteamLibrary
